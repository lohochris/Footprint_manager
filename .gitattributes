# Git attributes — Footprint Manager
* text=auto eol=lf

*.py text diff=python
*.ts text diff=typescript
*.tsx text diff=typescript
*.js text
*.jsx text
*.json text
*.md text
*.yml text
*.yaml text

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

docker-compose*.yml linguist-language=YAML
Dockerfile linguist-language=Dockerfile
